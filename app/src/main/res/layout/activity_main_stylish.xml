<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_parallax"
    android:fitsSystemWindows="true">

    <!-- Gear icon — tucked in corner, tiny alpha so Mom won't accidentally tap it -->
    <ImageButton
        android:id="@+id/caregiverSettingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_manage"
        android:contentDescription="Caregiver Settings (PIN protected)"
        android:alpha="0.35"
        app:tint="@color/mc_accent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"/>

    <!-- App title -->
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Friendai"
        android:textSize="38sp"
        android:textStyle="bold"
        android:textColor="@color/mc_accent"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:shadowColor="#307C4DFF"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:layout_marginTop="28dp"
        android:contentDescription="App title: Friendai"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Tagline -->
    <TextView
        android:id="@+id/headerTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your caring companion"
        android:textSize="15sp"
        android:textColor="@color/mc_text_hint"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.04"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/headerTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Voice output equalizer animation -->
    <com.friendai.EqualizerView
        android:id="@+id/equalizerView"
        android:layout_width="140dp"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:contentDescription="Voice output equalizer animation"
        app:layout_constraintTop_toBottomOf="@id/headerTagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Main conversation display card — fills all space between header and buttons -->
    <androidx.cardview.widget.CardView
        android:id="@+id/conversationCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/mc_card_bg"
        android:layout_margin="20dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/equalizerView"
        app:layout_constraintBottom_toTopOf="@id/listeningModeBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/conversationText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Hello! How can I help you today?"
            android:textSize="26sp"
            android:textColor="@color/mc_text_primary"
            android:gravity="center"
            android:padding="24dp"
            android:lineSpacingMultiplier="1.3"
            android:fontFamily="sans-serif"
            android:contentDescription="Conversation area"/>

        <TextView
            android:id="@+id/closedCaptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC1A1A2E"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:padding="12dp"
            android:gravity="center"
            android:visibility="gone"
            android:contentDescription="Speech transcription captions"
            tools:text="Transcribed speech appears here"/>

    </androidx.cardview.widget.CardView>

    <!-- Timed-listening mode banner — shown when always-listening is active -->
    <TextView
        android:id="@+id/listeningModeBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/listening_banner"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:background="#CC1565C1"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone"
        android:contentDescription="Timed listening mode is active. No button press needed."
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/talkButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- PRIMARY action: TALK — the core interaction for Mom -->
    <Button
        android:id="@+id/talkButton"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:text="🎤  Talk"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/mc_talk"
        android:elevation="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="Talk button. Tap and speak to your companion."
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toTopOf="@id/callCaregiverButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Secondary action: Call Caregiver -->
    <Button
        android:id="@+id/callCaregiverButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="📞  Call Caregiver"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/mc_danger"
        android:elevation="6dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="Call Caregiver button. Tap to call for help."
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toTopOf="@id/footerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Footer bar with sound/animation toggle icons -->
    <LinearLayout
        android:id="@+id/footerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:background="@drawable/footer_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/soundEffectIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_sound"
            android:contentDescription="Sound effects toggle"
            android:layout_marginEnd="28dp"
            android:alpha="0.55"/>

        <ImageView
            android:id="@+id/animationIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_animation"
            android:contentDescription="Animation toggle"
            android:layout_marginStart="28dp"
            android:alpha="0.55"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
