<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_parallax"
    android:fitsSystemWindows="true">

    <!-- Caregiver settings gear — tucked in the corner, faint so Mom won't tap it -->
    <ImageButton
        android:id="@+id/caregiverSettingsButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:src="@android:drawable/ic_menu_manage"
        android:contentDescription="Caregiver Settings (PIN protected)"
        android:alpha="0.30"
        app:tint="@color/mc_accent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"/>

    <!-- App title (compact, top) -->
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Friendai"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/mc_accent"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:layout_marginTop="16dp"
        android:contentDescription="App title: Friendai"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- PRIMARY action: TALK — now at the TOP for easy reach, no scrolling -->
    <Button
        android:id="@+id/talkButton"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:text="🎤  Talk"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/mc_talk"
        android:elevation="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:contentDescription="Talk button. Tap and speak to your companion."
        app:cornerRadius="20dp"
        app:layout_constraintTop_toBottomOf="@id/headerTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Secondary action: Call Caregiver — directly under Talk, still near the top -->
    <Button
        android:id="@+id/callCaregiverButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="📞  Call Caregiver"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/mc_danger"
        android:elevation="6dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        android:contentDescription="Call Caregiver button. Tap to call for help."
        app:cornerRadius="14dp"
        app:layout_constraintTop_toBottomOf="@id/talkButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Voice-activity indicator (thin), sits between the buttons and the transcript -->
    <com.friendai.EqualizerView
        android:id="@+id/equalizerView"
        android:layout_width="120dp"
        android:layout_height="34dp"
        android:layout_marginTop="10dp"
        android:contentDescription="Voice output equalizer animation"
        app:layout_constraintTop_toBottomOf="@id/callCaregiverButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Always-listening banner (shown only in hands-free mode) -->
    <TextView
        android:id="@+id/listeningModeBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/listening_banner"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:background="#CC1565C1"
        android:gravity="center"
        android:padding="7dp"
        android:visibility="gone"
        android:contentDescription="Timed listening mode is active. No button press needed."
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/equalizerView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Conversation transcript — fills all remaining space below the buttons -->
    <androidx.cardview.widget.CardView
        android:id="@+id/conversationCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/mc_card_bg"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/listeningModeBanner"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/conversationText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Tap Talk and say hello 🙂"
            android:textSize="22sp"
            android:textColor="@color/mc_text_primary"
            android:gravity="top|start"
            android:padding="20dp"
            android:lineSpacingMultiplier="1.25"
            android:fontFamily="sans-serif"
            android:contentDescription="Conversation transcript"/>

        <TextView
            android:id="@+id/closedCaptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC1A1A2E"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:padding="12dp"
            android:gravity="center"
            android:visibility="gone"
            android:contentDescription="Speech transcription captions"
            tools:text="Transcribed speech appears here"/>

    </androidx.cardview.widget.CardView>

    <!-- Hidden holders for the sound/animation toggle views the code references.
         Kept off-screen so the main UI stays clean but findViewById still works. -->
    <LinearLayout
        android:id="@+id/footerBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/soundEffectIcon"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:src="@drawable/ic_sound"
            android:contentDescription="Sound effects toggle"/>

        <ImageView
            android:id="@+id/animationIcon"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:src="@drawable/ic_animation"
            android:contentDescription="Animation toggle"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
