<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_parallax"
    android:fitsSystemWindows="true">

    <!-- App title -->
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Friendai"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/mc_accent"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:layout_marginTop="14dp"
        android:contentDescription="App title: Friendai"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ============ HOME PANEL (greeting + call caregiver) ============ -->
    <LinearLayout
        android:id="@+id/homePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/headerTitle"
        app:layout_constraintBottom_toTopOf="@id/listeningModeBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/homeGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello 🙂\nTap Talk and just speak —\nI'm here to keep you company."
            android:textSize="24sp"
            android:textColor="@color/mc_text_primary"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:contentDescription="Welcome message"/>

        <Button
            android:id="@+id/callCaregiverButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📞  Call Caregiver"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/mc_danger"
            android:elevation="4dp"
            android:layout_marginTop="34dp"
            android:contentDescription="Call Caregiver button. Tap to call for help."
            app:cornerRadius="14dp"/>

    </LinearLayout>

    <!-- ============ CHAT PANEL (conversation transcript) ============ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/conversationCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/mc_card_bg"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerTitle"
        app:layout_constraintBottom_toTopOf="@id/listeningModeBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/conversationText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Your conversation will appear here.\n\nTap Talk to begin."
            android:textSize="21sp"
            android:textColor="@color/mc_text_primary"
            android:gravity="top|start"
            android:padding="20dp"
            android:lineSpacingMultiplier="1.25"
            android:contentDescription="Conversation transcript"/>

        <TextView
            android:id="@+id/closedCaptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC1A1A2E"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:padding="12dp"
            android:gravity="center"
            android:visibility="gone"
            android:contentDescription="Speech transcription captions"
            tools:text="Transcribed speech appears here"/>

    </androidx.cardview.widget.CardView>

    <!-- Always-listening banner (hands-free mode only) -->
    <TextView
        android:id="@+id/listeningModeBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/listening_banner"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:background="#CC1565C1"
        android:gravity="center"
        android:padding="7dp"
        android:visibility="gone"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="Timed listening mode is active. No button press needed."
        app:layout_constraintBottom_toTopOf="@id/equalizerView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Thin voice indicator, just above the Talk button -->
    <com.friendai.EqualizerView
        android:id="@+id/equalizerView"
        android:layout_width="110dp"
        android:layout_height="30dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="Voice output equalizer animation"
        app:layout_constraintBottom_toTopOf="@id/talkButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- PRIMARY action: TALK — always visible, just above the nav bar -->
    <Button
        android:id="@+id/talkButton"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="🎤  Talk"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/mc_talk"
        android:elevation="8dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="Talk button. Tap and speak to your companion."
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bottom navigation bar — like a normal app -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/mc_card_bg"
        app:elevation="12dp"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/nav_item_tint"
        app:itemTextColor="@color/nav_item_tint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Off-screen holders so the sound/animation views the code references still resolve -->
    <LinearLayout
        android:id="@+id/footerBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/soundEffectIcon"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:src="@drawable/ic_sound"
            android:contentDescription="Sound effects toggle"/>

        <ImageView
            android:id="@+id/animationIcon"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:src="@drawable/ic_animation"
            android:contentDescription="Animation toggle"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
